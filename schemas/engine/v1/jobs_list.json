{
  "$id": "jobseeker:engine/v1/jobs_list",
  "title": "jobs_list",
  "input": {
    "type": "object",
    "properties": {
      "top_n": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "How many jobs to return (default: ranking.top_n in config.json)."
      },
      "shortlist": {
        "type": "boolean",
        "description": "Only jobs whose application is in the shortlisted state."
      }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "top_n": {
        "type": "integer"
      },
      "count": {
        "type": "integer"
      },
      "eligible": {
        "type": "integer"
      },
      "vetoed": {
        "type": "integer",
        "description": "Active jobs left out because a gate vetoed them."
      },
      "profile_version": {
        "type": [
          "integer",
          "null"
        ]
      },
      "results": {
        "type": "array",
        "items": {
          "$ref": "_common.json#/$defs/JobSummary"
        }
      }
    },
    "required": [
      "top_n",
      "count",
      "eligible",
      "vetoed",
      "results"
    ]
  }
}
