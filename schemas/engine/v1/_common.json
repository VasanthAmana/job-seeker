{
  "$id": "jobseeker:engine/v1/_common",
  "title": "Shared definitions for Engine API v1",
  "$defs": {
    "JobId": {
      "type": "string",
      "minLength": 1,
      "description": "A job id (job_...) or its dedupe key."
    },
    "ApplicationState": {
      "type": "string",
      "enum": ["found", "shortlisted", "resume_prepared", "applied", "interview", "offer", "rejected"]
    },
    "ScoreMethod": {
      "type": ["string", "null"],
      "enum": ["rule", "assistant", "ai_review", null]
    },
    "JobSummary": {
      "type": "object",
      "required": ["job_id", "key", "title", "company", "status", "sources", "score", "score_method", "vetoed", "flags", "partial", "application_state"],
      "properties": {
        "job_id": { "type": "string" },
        "key": { "type": "string", "description": "The dedupe key." },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "location": { "type": ["string", "null"] },
        "workplace": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["active", "skipped", "unreachable", "expired"] },
        "sources": { "type": "array", "items": { "type": "string" }, "description": "Every connector the job was seen through." },
        "score": { "type": ["integer", "null"], "description": "The shown score, 0-100." },
        "score_10": { "type": ["number", "null"] },
        "band": { "type": ["string", "null"] },
        "score_method": { "$ref": "#/$defs/ScoreMethod" },
        "vetoed": { "type": "boolean" },
        "flags": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": ["string", "null"] },
        "partial": { "type": "boolean", "description": "True when no description has been fetched." },
        "deadline": { "type": ["string", "null"] },
        "urgent": { "type": "boolean" },
        "application_state": {
          "anyOf": [{ "$ref": "#/$defs/ApplicationState" }, { "type": "null" }]
        }
      }
    },
    "GuardFindings": {
      "type": "object",
      "description": "The posting guard's findings for the stored description.",
      "required": ["verdict"],
      "properties": {
        "verdict": { "type": "string" },
        "hidden_blocks": { "type": "array", "items": { "type": "string" } },
        "instruction_like": { "type": "array", "items": { "type": "string" } },
        "hidden_urls": { "type": "array", "items": { "type": "string" } },
        "invisible_text": { "type": "array", "items": { "type": "string" } },
        "homoglyph_runs": { "type": "array", "items": { "type": "string" } },
        "invisible_chars": { "type": "object", "additionalProperties": { "type": "integer" } },
        "invisible_flagged": { "type": "integer" },
        "visible_url_count": { "type": "integer" }
      }
    },
    "Evidence": {
      "type": "object",
      "required": ["source_id", "quote"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0, "description": "Start offset in the source text; filled in by job-seeker when omitted." },
        "end": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1, "description": "The exact words from the source (whitespace may differ)." }
      }
    },
    "Claim": {
      "type": "object",
      "required": ["id", "type", "value", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,80}$" },
        "type": {
          "type": "string",
          "enum": ["role", "skill", "achievement", "education", "certification", "domain", "location", "preference", "fact"]
        },
        "value": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Evidence" } }
      }
    },
    "ProfileDocument": {
      "type": "object",
      "required": ["schema", "claims"],
      "properties": {
        "schema": { "const": "profile@1" },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/Claim" } },
        "preferences": { "type": "object" }
      }
    },
    "SourceSummary": {
      "type": "object",
      "required": ["source_id", "kind", "sha256", "length", "imported_at"],
      "properties": {
        "source_id": { "type": "string" },
        "kind": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "sha256": { "type": "string" },
        "length": { "type": "integer" },
        "imported_at": { "type": "string" }
      }
    },
    "HumanStep": {
      "type": "object",
      "required": ["id", "reason", "open_what", "opened_at"],
      "properties": {
        "id": { "type": "string" },
        "service": { "type": ["string", "null"] },
        "reason": { "type": "string" },
        "detail": { "type": ["string", "null"] },
        "open_what": { "type": "string", "description": "What the user should open to clear it." },
        "opened_at": { "type": "string" },
        "resolved_at": { "type": ["string", "null"] }
      }
    }
  }
}
