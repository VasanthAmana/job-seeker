          {
            "$ref": "_common.json#/$defs/ApplicationState"
          },
          {
            "type": "null"
          }
        ]
      },
      "state": {
        "$ref": "_common.json#/$defs/ApplicationState"
      },
      "changed": {
        "type": "boolean"
      }
    },
    "required": [
