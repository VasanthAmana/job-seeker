        "$ref": "_common.json#/$defs/JobId"
      },
      "state": {
        "$ref": "_common.json#/$defs/ApplicationState"
      },
      "note": {
        "type": "string",
        "maxLength": 500,
        "description": "Optional context, in the user's words."
      }
    },
    "required": [
