{
  "$id": "jobseeker:engine/v1/secrets_set",
  "title": "secrets_set",
  "input": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
      },
      "value": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "name",
      "value"
    ],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "backend": {
        "type": "string"
      },
      "replaced": {
        "type": "boolean"
      }
    },
    "required": [
      "name",
      "backend",
      "replaced"
    ]
  }
}
