{
  "$id": "jobseeker:engine/v1/human_steps_list",
  "title": "human_steps_list",
  "input": {
    "type": "object",
    "properties": {
      "include_resolved": {
        "type": "boolean",
        "description": "Also list steps already cleared (default false)."
      }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "count": {
        "type": "integer"
      },
      "results": {
        "type": "array",
        "items": {
          "$ref": "_common.json#/$defs/HumanStep"
        }
      }
    },
    "required": [
      "count",
      "results"
    ]
  }
}
