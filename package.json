{
  "name": "job-seeker",
  "version": "0.0.1",
  "description": "Job-search engine served over MCP: search, ranking, applications and profile management, driven from an AI assistant.",
  "private": true,
  "type": "module",
  "bin": {
    "job-seeker": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "fixtures/demo"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "gen:types": "node scripts/gen-engine-types.mjs",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "entities": "^7.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "globals": "^14.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
